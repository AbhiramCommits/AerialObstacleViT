# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/

# --- Datasets (regenerated by scripts/fetch_data.py) ---
# NOTE: leading slash matters -- `data/` without it would also ignore the
# source package directory `aerial_vit/data/`.
/data/
*.zip

# --- Model weights (never commit binaries) ---
*.pt
*.pth
*.ckpt
*.torchscript
*.onnx
/artifacts/models/*
!/artifacts/models/.gitkeep

# --- Run outputs: keep the summary JSON/CSV artifacts, drop everything bulky ---
/artifacts/runs/*
!/artifacts/runs/.gitkeep
/artifacts/tmp/*
!/artifacts/tmp/.gitkeep
/artifacts/data/
/artifacts/*.log

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp
